@@ -406,7 +406,12 @@ class LiveLearningRun:
         self.use_gate = use_gate
         self.inject_cheat = inject_cheat
         self.verifier = LiveRunnerVerifier(runner=runner, check=exact_check)
-        self.state = ProbabilisticState(n_min=n_min)
+        # H4-2 (§14, live-wired): decision-time predictions vs realized held-out outcomes
+        # feed a per-run Calibrator; estimate() serves the calibrated posterior once the
+        # observation floor is met (identity before that — cold start defers to §8 dials).
+        from .calibration import Calibrator
+        self.calibrator = Calibrator()
+        self.state = ProbabilisticState(n_min=n_min, calibrator=self.calibrator)
         self.lib = SkillLibrary()
         self.lib.mark_held_out([t.id for t in corpus.held_out])    # quarantine held-out ids
         # M1 (RC-3, live-wired): GrowthRule is the actual source of truth for what the loop
@@ -515,8 +520,15 @@ class LiveLearningRun:
             skill = pick.skill
 
             # 1) measure current held-out competence through the runner -> update the state
+            # H4-2: log the decision-time prediction BEFORE the update (P1: the prediction
+            # is what the policy believed when it acted, not what hindsight says).
+            p_hat = self.state.estimate(skill, "task").mean
             hp, hn = self._eval(skill, "held_out")
             self.state.update(skill, "task", hp, hn - hp)
+            for _ in range(hp):
+                self.calibrator.observe(p_hat, 1)
+            for _ in range(hn - hp):
+                self.calibrator.observe(p_hat, 0)
             # feed the LEARNED policy the realized learning-gain since this skill was last picked
             if self.policy is not None:
                 cur = self.state.estimate(skill, "task").mean
