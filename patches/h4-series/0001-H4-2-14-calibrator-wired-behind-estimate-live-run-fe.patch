diff --git a/mdlp/mdlp/calibration.py b/mdlp/mdlp/calibration.py
index ff5b9e7..27ffdbf 100644
--- a/mdlp/mdlp/calibration.py
+++ b/mdlp/mdlp/calibration.py
@@ -54,7 +54,17 @@ def isotonic_fit(preds: list[float], outcomes: list[int]) -> list[tuple[float, f
         return []
     blocks: list[list[float]] = []  # [sum_y, weight, x_min, x_max]
     for x, y in sorted(zip(preds, outcomes)):
-        blocks.append([float(y), 1.0, x, x])
+        # H4-2 fix: TIED predictions must share one block. Without this, equal-x
+        # observations whose outcomes happen to arrive in ascending order form separate
+        # same-x blocks that PAV never pools (it only pools DESCENDING violations), and
+        # `recalibrate` then returns the FIRST tied block — e.g. 0.0 for a 50/50 outcome
+        # stream at a single p̂, exactly the shape a Beta posterior feeds it. Found by
+        # the H4-2 wiring test; fix and wire in one commit (the repo's own L-044 rule).
+        if blocks and blocks[-1][3] == x:
+            blocks[-1][0] += float(y)
+            blocks[-1][1] += 1.0
+        else:
+            blocks.append([float(y), 1.0, x, x])
         while len(blocks) >= 2 and (blocks[-2][0] / blocks[-2][1]) > (blocks[-1][0] / blocks[-1][1]):
             sy2, w2, _xmin2, xmax2 = blocks.pop()
             sy1, w1, xmin1, _xmax1 = blocks.pop()
