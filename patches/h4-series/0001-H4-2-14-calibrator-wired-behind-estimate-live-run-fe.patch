diff --git a/mdlp/mdlp/state.py b/mdlp/mdlp/state.py
index 1eb0bd1..68f4305 100644
--- a/mdlp/mdlp/state.py
+++ b/mdlp/mdlp/state.py
@@ -74,7 +74,14 @@ class ProbabilisticState:
     """The growing competence field. Backed by a StateStore if given, else in-process."""
 
     def __init__(self, store=None, *, prior: tuple[float, float] = (1.0, 1.0),
-                 gamma_slow: float = 0.995, gamma_fast: float = 0.9, n_min: float = 20.0):
+                 gamma_slow: float = 0.995, gamma_fast: float = 0.9, n_min: float = 20.0,
+                 calibrator=None):
+        # H4-2 (§14.2): an optional Calibrator makes estimate() return the CALIBRATED
+        # posterior — mean through the isotonic map, SE from the deflated n_eff — so every
+        # downstream consumer of estimate() (significant(), Thompson, the gates) inherits
+        # honest confidence automatically. None (the default) is byte-identical to the
+        # pre-H4-2 behavior: calibration is opt-in wiring, not a changed mechanism.
+        self.calibrator = calibrator
         self.store = store
         self.prior = prior
         self.gamma_slow = gamma_slow
@@ -198,6 +205,13 @@ class ProbabilisticState:
     # -- read models ---------------------------------------------------------
     def estimate(self, skill: str, difficulty: str, context: Optional[str] = None) -> Posterior:
         m = self.cell(skill, difficulty, context).mastery
+        if self.calibrator is not None:
+            # §14.2: mean via the fitted recalibration map; SE widened via the deflated
+            # effective count (never narrower than reality — Calibrator.n_eff only shrinks n).
+            mean = self.calibrator.recalibrate(m.mean)
+            n = self.calibrator.n_eff(m.n_eff)
+            se = math.sqrt(max(mean * (1.0 - mean), 1e-12) / (n + 1.0))
+            return Posterior(mean, se, n)
         return Posterior(m.mean, math.sqrt(m.var), m.n_eff)
 
     def drift_estimate(self, skill: str, difficulty: str, context: Optional[str] = None) -> Posterior:
diff --git a/mdlp/tests/test_h4_wiring.py b/mdlp/tests/test_h4_wiring.py
new file mode 100644
index 0000000..fd5a5dc
--- /dev/null
+++ b/mdlp/tests/test_h4_wiring.py
@@ -0,0 +1,59 @@
+"""H4 wire-or-retract regression tests (HANDOVER-v4 T1).
+
+Each test guards one wiring: the construct must be reachable from the live path,
+not merely importable. The pre-H4 audit finding (AUDIT-TA-2026-08 / IX-064) was
+five constructs with tests and no live callers — these tests make that state fail.
+"""
+import math
+import random
+
+from mdlp.calibration import Calibrator
+from mdlp.state import ProbabilisticState
+
+
+def test_estimate_identity_without_calibrator():
+    st = ProbabilisticState(n_min=8.0)
+    st.update("s", "task", 3, 1)
+    p = st.estimate("s", "task")
+    assert 0.0 < p.mean < 1.0 and p.se > 0.0
+
+
+def test_estimate_calibrated_when_wired():
+    cal = Calibrator(n_floor=20)
+    st = ProbabilisticState(n_min=8.0, calibrator=cal)
+    st.update("s", "task", 6, 2)
+    raw = ProbabilisticState(n_min=8.0)
+    raw.update("s", "task", 6, 2)
+    # Below the observation floor the calibrator is identity on the mean...
+    assert math.isclose(st.estimate("s", "task").mean, raw.estimate("s", "task").mean)
+    # ...then feed an over-confident history AT the posterior's own operating point:
+    # predictions ~the raw mean, reality ~50/50 (in-distribution for the isotonic map).
+    p_op = raw.estimate("s", "task").mean
+    rng = random.Random(0)
+    for _ in range(200):
+        cal.observe(p_op, 1 if rng.random() < 0.5 else 0)
+    assert cal.ready() and cal.ece() > 0.1
+    calibrated = st.estimate("s", "task")
+    # SE must WIDEN (n_eff deflated) relative to the raw posterior — never narrow.
+    assert calibrated.n < raw.estimate("s", "task").n
+    assert calibrated.se > raw.estimate("s", "task").se
+
+
+def test_live_run_feeds_calibrator():
+    from mdlp.corpus import CorpusFakeRunner, LiveLearningRun, default_corpus
+    corpus = default_corpus()
+    run = LiveLearningRun(corpus, CorpusFakeRunner(), n_min=4.0, rng_seed=1)
+    assert run.calibrator is run.state.calibrator          # one calibrator, shared
+    run.run(3)
+    assert len(run.calibrator._preds) > 0                  # observations actually flowed
+
+
+def test_isotonic_tied_predictions_pool_into_one_block():
+    """The H4-2-found calibration bug: tied p̂ with mixed outcomes must map to their
+    pooled mean, never to the first tied observation's outcome."""
+    from mdlp.calibration import isotonic_fit, recalibrate
+    preds = [0.6] * 10
+    outcomes = [0, 1] * 5                       # ascending-start order — the failing shape
+    fit = isotonic_fit(preds, outcomes)
+    assert len(fit) == 1
+    assert abs(recalibrate(0.6, fit) - 0.5) < 1e-9
