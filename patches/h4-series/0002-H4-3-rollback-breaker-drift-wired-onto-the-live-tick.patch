From: Nithun <nithunram@gmail.com>
Date: Tue, 18 Aug 2026 21:26:06 +0530
Subject: [PATCH 2/6] H4-3: rollback+breaker+drift wired onto the live tick;
 per-skill rollback targeting; miscalibration trigger plumbed, disarmed with
 in-code rationale

---
 mdlp/mdlp/calibration.py     | 13 ++++++++-
 mdlp/mdlp/corpus.py          | 51 +++++++++++++++++++++++++++++++++++-
 mdlp/mdlp/loop.py            |  5 +++-
 mdlp/mdlp/state.py           | 17 ++++++++----
 mdlp/tests/test_h4_wiring.py | 42 ++++++++++++++++++++++++++++-
 5 files changed, 119 insertions(+), 9 deletions(-)

diff --git a/mdlp/mdlp/calibration.py b/mdlp/mdlp/calibration.py
index 27ffdbf..abf9356 100644
--- a/mdlp/mdlp/calibration.py
+++ b/mdlp/mdlp/calibration.py
@@ -127,7 +127,18 @@ class Calibrator:
         return n / (1.0 + self.lambda_cal * self.ece())
 
     def miscalibrated(self) -> bool:
-        """The 5th circuit-breaker trigger: the band's confidence is provably off."""
+        """The 5th circuit-breaker trigger: the band's confidence is provably off.
+
+        H4-3 status note (wiring finding, carried to MDLP research via HANDOVER): this
+        cumulative-raw-history statistic is correct for a STATIC band but over-fires on a
+        genuinely-learning cold start (the raw prior is always miscalibrated at first —
+        that is what learning fixes), and every in-run alternative tried during wiring
+        failed a different way: in-sample recalibrated ECE is degenerately ~0 (each PAV
+        block bins at its own mean); a fit-on-first-half/judge-second-half split cannot
+        distinguish learning nonstationarity from broken confidence and extrapolates
+        badly outside the fitted range. Until §14 defines the separating statistic, the
+        live loop passes `miscalibrated=False` at the (plumbed, tested) breaker flag —
+        see the arming site in corpus.py."""
         if not self.ready():
             return False
         return self.ece() > self.ece_max or self.brier() > self.brier_max
diff --git a/mdlp/mdlp/corpus.py b/mdlp/mdlp/corpus.py
index 564be42..14020aa 100644
--- a/mdlp/mdlp/corpus.py
+++ b/mdlp/mdlp/corpus.py
@@ -40,7 +40,7 @@ from typing import Optional
 from .decision import Candidate, DecisionEngine
 from .graph import PathwayGraph, PrereqGapDetector
 from .growth import GrowthRule
-from .loop import commit_gate
+from .loop import CircuitBreaker, commit_gate, rollback_fires
 from .memory import Context, SkillLibrary
 from .revisit import check_triggers
 from .scheduler import Scheduler
@@ -460,6 +460,18 @@ class LiveLearningRun:
         # before the gate decides (pregate_deltas), and how many the gate actually committed.
         self.pregate_deltas: list[float] = []
         self._committed: int = 0
+        # H4-3 (§8/§14.3, live-wired): the dormant safety kit onto the live tick.
+        # drift_estimate (fast-decay — previously written every tick, read by NOTHING)
+        # now drives the rollback check; the breaker counts consecutive rollbacks and
+        # takes §14.3's miscalibration trigger; a trip HALTS the run, recorded not silent.
+        self.breaker = CircuitBreaker()
+        self.rollback_log: list[dict] = []
+        self.halted: Optional[dict] = None
+        # PER-SKILL rollback targets: a drop in skill X may only retire X's own notes —
+        # a global LIFO would retire an innocent skill's note on another's regression
+        # (caught by the nova prereq test during wiring).
+        self._committed_stack: dict[str, list[str]] = {}
+        self._held_baseline: dict[str, float] = {}          # fixed per-skill baseline (RC-7)
 
     def _ctx_payloads(self, skill: str) -> list[dict]:
         if not self.use_learning:
@@ -529,6 +541,42 @@ class LiveLearningRun:
                 self.calibrator.observe(p_hat, 1)
             for _ in range(hn - hp):
                 self.calibrator.observe(p_hat, 0)
+            # H4-3: fixed ancestor baseline (RC-7 — a FIXED reference, never just the
+            # parent tick) captured on first sight of the skill.
+            self._held_baseline.setdefault(skill, self.state.estimate(skill, "task").mean)
+            # H4-3: rollback fires only on a fresh, adequately-powered, significant drop
+            # (RC-5) — the SE comes from the fast-decay drift posterior, the write-only
+            # signal this wiring finally reads.
+            drift = self.state.drift_estimate(skill, "task")
+            d_drop = self._held_baseline[skill] - self.state.estimate(skill, "task").mean
+            rolled = False
+            own_notes = self._committed_stack.get(skill, [])
+            if own_notes and rollback_fires(
+                    d_drop=d_drop, se=drift.se, powered=(hn >= 4)):
+                rb_ctx = own_notes.pop()
+                self.lib.retire(rb_ctx)
+                rolled = True
+                self.rollback_log.append({"tick": t, "skill": skill,
+                                          "rolled_back_ctx": rb_ctx, "d_drop": d_drop})
+            # The §14.3 miscalibration trigger is PLUMBED (CircuitBreaker takes the flag;
+            # Calibrator.miscalibrated() implements the out-of-sample check) but DISARMED
+            # on the live path, with the reason stated rather than hidden: wiring exposed
+            # two failure modes no in-run statistic here can currently separate —
+            # (a) per-item observation floors mis-scale (one 40-item tick clears a
+            #     20-observation floor and judges binomial noise between halves of a
+            #     single cold prediction), and
+            # (b) any fit-on-history-judge-recent scheme trips on LEARNING itself: a
+            #     genuinely-improving posterior legitimately outruns an old map, and
+            #     "nonstationary because learning" is indistinguishable from
+            #     "nonstationary because broken" without a statistic MDLP's §14 does
+            #     not yet define.
+            # Open calibration-research item, carried back to MDLP via HANDOVER; arming
+            # is a one-word change once §14 defines the separating statistic.
+            if self.breaker.record(rolled_back=rolled, miscalibrated=False):
+                self.halted = {"tick": t, "reasons": list(self.breaker.reasons)}
+                if on_tick:
+                    on_tick(t, n_ticks, skill, self.verifier.calls, self.verifier.errors)
+                break
             # feed the LEARNED policy the realized learning-gain since this skill was last picked
             if self.policy is not None:
                 cur = self.state.estimate(skill, "task").mean
@@ -618,6 +666,7 @@ class LiveLearningRun:
                     if g.accept:
                         self.lib.add(Context(draft.id, skill, draft.payload))
                         self._committed += 1
+                        self._committed_stack.setdefault(skill, []).append(draft.id)  # H4-3
                 else:
                     self.lib.add(Context(draft.id, skill, draft.payload))
                     self._committed += 1
