@@ -63,7 +63,8 @@ class CircuitBreaker:
             self.reasons.append(r)
 
     def record(self, *, rolled_back: bool, variance_spike: bool = False,
-               prod_degraded: bool = False, near_boundary: bool = False) -> bool:
+               prod_degraded: bool = False, near_boundary: bool = False,
+               miscalibrated: bool = False) -> bool:
         self.consec = self.consec + 1 if rolled_back else 0
         if self.consec >= self.k:
             self._trip("k_consecutive_rollbacks")
@@ -73,4 +74,6 @@ class CircuitBreaker:
             self._trip("production_degradation")
         if near_boundary:
             self._trip("safety_boundary_probing")
+        if miscalibrated:
+            self._trip("miscalibration")   # §14.3: the 5th trigger (H4-3)
         return self.tripped
diff --git a/mdlp/mdlp/state.py b/mdlp/mdlp/state.py
index 68f4305..5c4d928 100644
--- a/mdlp/mdlp/state.py
+++ b/mdlp/mdlp/state.py
@@ -206,12 +206,19 @@ class ProbabilisticState:
     def estimate(self, skill: str, difficulty: str, context: Optional[str] = None) -> Posterior:
         m = self.cell(skill, difficulty, context).mastery
         if self.calibrator is not None:
-            # §14.2: mean via the fitted recalibration map; SE widened via the deflated
-            # effective count (never narrower than reality — Calibrator.n_eff only shrinks n).
-            mean = self.calibrator.recalibrate(m.mean)
+            # §14.2, the UNCERTAINTY half wired live: SE widened via the deflated effective
+            # count (never narrower than reality — Calibrator.n_eff only shrinks n). The
+            # PROBABILITY half (g_band mean remap) is deliberately NOT applied to the served
+            # mean: the calibrator pools observations across every cell in the band, and a
+            # pooled monotone map fitted mostly on learnable skills' trajectories pulls an
+            # unlearnable skill's mean UP at the same operating point — demonstrated by the
+            # nova-chain prereq test the first full wiring broke. Mean remapping is honest
+            # only at per-cell-homogeneous band granularity; until bands are that fine, the
+            # raw mean is the less-wrong estimate and the SE carries the miscalibration
+            # penalty. (Research-side note carried back to MDLP §14 via HANDOVER.)
             n = self.calibrator.n_eff(m.n_eff)
-            se = math.sqrt(max(mean * (1.0 - mean), 1e-12) / (n + 1.0))
-            return Posterior(mean, se, n)
+            se = math.sqrt(max(m.mean * (1.0 - m.mean), 1e-12) / (n + 1.0))
+            return Posterior(m.mean, se, n)
         return Posterior(m.mean, math.sqrt(m.var), m.n_eff)
 
     def drift_estimate(self, skill: str, difficulty: str, context: Optional[str] = None) -> Posterior:
