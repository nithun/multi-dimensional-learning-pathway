         cal.observe(p_op, 1 if rng.random() < 0.5 else 0)
     assert cal.ready() and cal.ece() > 0.1
     calibrated = st.estimate("s", "task")
-    # SE must WIDEN (n_eff deflated) relative to the raw posterior — never narrow.
