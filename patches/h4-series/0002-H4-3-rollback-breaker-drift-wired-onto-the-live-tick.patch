+
+
+def test_breaker_takes_miscalibration_as_fifth_trigger():
+    from mdlp.loop import CircuitBreaker
+    br = CircuitBreaker()
+    assert br.record(rolled_back=False, miscalibrated=True)
+    assert "miscalibration" in br.reasons
+
+
+def test_live_run_reads_drift_and_owns_breaker():
+    """H4-3 wiring: drift_estimate gains a live reader; the run owns a breaker and a
+    rollback log; a healthy run neither rolls back nor halts."""
+    from mdlp.corpus import CorpusFakeRunner, LiveLearningRun, default_corpus
+    run = LiveLearningRun(default_corpus(), CorpusFakeRunner(), n_min=4.0, rng_seed=2)
+    run.run(4)
+    assert run.halted is None and run.rollback_log == []
+    assert run.breaker.consec == 0
+
+
+def test_rollback_retires_last_committed_note_and_breaker_trips():
+    """H4-3 end-to-end on synthetic state: force a powered significant drop after a
+    commit; the last committed note is retired; k drops trip the breaker and halt."""
+    from mdlp.corpus import CorpusFakeRunner, LiveLearningRun, default_corpus
+    run = LiveLearningRun(default_corpus(), CorpusFakeRunner(), n_min=4.0, rng_seed=3)
+    run.breaker.k = 1
+    skill = run.corpus.skills[0]
+    # simulate: a committed note exists, baseline was high, competence has collapsed
+    from mdlp.memory import Context
+    run.lib.add(Context("note:1", skill, {"note": "x"}))
+    run._committed_stack.setdefault(skill, []).append("note:1")
+    run._held_baseline[skill] = 0.95
+    for _ in range(6):
+        run.state.update(skill, "task", 0, 4)     # hard fail stream → drift SE tightens low
+    run.run(2)
+    assert run.rollback_log, "a powered significant drop must fire rollback"
+    assert all(c.id != "note:1" for c in run.lib.retrieve(skill))
+    assert run.halted is not None and "k_consecutive_rollbacks" in run.halted["reasons"]
