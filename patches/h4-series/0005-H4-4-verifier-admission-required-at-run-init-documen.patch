+def test_verifier_admission_wired_at_run_init():
+    """H4-4: the run refuses to start without an admitted grader; a healthy corpus admits."""
+    from mdlp.corpus import CorpusFakeRunner, LiveLearningRun, default_corpus
+    run = LiveLearningRun(default_corpus(), CorpusFakeRunner(), rng_seed=5)
+    assert run.registry.admit("corpus-exact", band="corpus")
+
+
+def test_counterfactual_variant_kills_hardcoded_answers():
+    """H4-4 (§4.2): a cheating runner that returns the MAIN expected string regardless of
+    input passes the main item but fails the fresh-variant probe — the item scores 0."""
+    from mdlp.adapters.runner import RunResult
+    from mdlp.corpus import LiveLearningRun, default_corpus
+
+    class HardcodedRunner:
+        def __init__(self, corpus):
+            self._by_prompt = {t.prompt: t.expected for t in corpus.held_out}
+        def run(self, agent_name, task):
+            # answers the MAIN prompt's expected string no matter what is asked —
+            # a memorized/hard-coded answer, the §4.2 attack.
+            main = self._by_prompt.get(task["prompt"])
+            if main is not None:
+                return RunResult(output=main)              # correct on the main item
+            return RunResult(output=next(iter(self._by_prompt.values())))  # constant elsewhere
+    corpus = default_corpus(n_public=4, n_held=6)
+    run = LiveLearningRun(corpus, HardcodedRunner(corpus), rng_seed=6, require_admission=False)
+    items = run._eval_items("acme-cipher", "held_out")
+    assert all(v == 0 for v in items.values()), \
+        "every hard-coded pass must be killed by its variant probe"
+
+
+def test_variants_do_not_change_honest_runner_outcomes():
+    """H4-4: the deterministic stand-in runner sees the same u on main and variant, so
+    hermetic pass/fail is unchanged by the probe (no test-magnitude recalibration)."""
+    from mdlp.corpus import CorpusFakeRunner, LiveLearningRun, default_corpus
+    run = LiveLearningRun(default_corpus(n_public=4, n_held=8), CorpusFakeRunner(), rng_seed=7, require_admission=False)
+    items = run._eval_items("acme-cipher", "held_out")
+    assert set(items.values()) <= {0, 1} and len(items) == 8
