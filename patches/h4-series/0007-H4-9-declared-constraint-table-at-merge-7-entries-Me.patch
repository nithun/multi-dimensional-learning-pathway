+            ctx["edges_after"] = list(edges.keys())
+            _bn, _be, delta_violations, dflags = evaluate(table, delta=delta, ctx=ctx)
+            report.flags.extend(dflags)
+            if any(True for _cid, _r in delta_violations):
+                for cid, reason in delta_violations:
