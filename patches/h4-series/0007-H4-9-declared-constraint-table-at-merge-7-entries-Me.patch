diff --git a/mdlp/tests/test_constraints.py b/mdlp/tests/test_constraints.py
new file mode 100644
index 0000000..b8f02d2
--- /dev/null
+++ b/mdlp/tests/test_constraints.py
@@ -0,0 +1,102 @@
+"""H4-9 (DL §6.3): the constraint table at merge() — one violating-input fire test per
+entry (a constraint that cannot be made to fire is the inert-alarm failure, §12.4)."""
+from mdlp.stores import embedded
+from mdlp.stores.schemas import Edge, GraphDelta, SkillNode
+
+
+def _g():
+    s = embedded()
+    return s, s.graph
+
+
+def test_migrated_liveness_identical():
+    """C-LIVENESS-SHAPE: same rejection, same reason string as the pre-table check."""
+    s, g = _g()
+    rep = g.merge(GraphDelta(adds=[SkillNode(skill="x", status="draft")]))
+    assert rep.rejected and rep.rejected[0][0] == "x"
+    assert any(cid == "C-LIVENESS-SHAPE" for _t, cid, _sev in rep.flags)
+    s.close()
+
+
+def test_edge_type_fires():
+    s, g = _g()
+    g.merge(GraphDelta(adds=[SkillNode(skill="a"), SkillNode(skill="b")]))
+    rep = g.merge(GraphDelta(edges=[Edge(src="a", dst="b", kind="teleport")]))
+    assert rep.rejected and rep.rejected[0][1] == "C-EDGE-TYPE"
+    s.close()
+
+
+def test_conf_range_fires():
+    s, g = _g()
+    g.merge(GraphDelta(adds=[SkillNode(skill="a"), SkillNode(skill="b")]))
+    rep = g.merge(GraphDelta(edges=[Edge(src="a", dst="b", confidence=1.7)]))
+    assert rep.rejected and rep.rejected[0][1] == "C-CONF-RANGE"
+    s.close()
+
+
+def test_acyclic_fires_and_rejects_whole_delta():
+    """C-ACYCLIC — NEW protection at this layer: TA previously enforced acyclicity only
+    in the in-process PathwayGraph, never at the store write path. A cycle-closing delta
+    rejects whole (unattributable → the §6.3 fallback), leaving the live graph untouched."""
+    s, g = _g()
+    g.merge(GraphDelta(adds=[SkillNode(skill="a"), SkillNode(skill="b")],
+                       edges=[Edge(src="a", dst="b")]))
+    before = len(list(g.prereqs("a")))
+    rep = g.merge(GraphDelta(edges=[Edge(src="b", dst="a")]))       # closes a→b→a
+    assert any("C-ACYCLIC" in r for _id, r in rep.rejected)
+    assert rep.added == []                                          # nothing applied
+    assert len(list(g.prereqs("a"))) == before                      # graph untouched
+    s.close()
+
+
+def test_namespace_fires():
+    s, g = _g()
+    rep = g.merge(GraphDelta(adds=[SkillNode(skill="maintenance")]))
+    assert rep.rejected and rep.rejected[0][1] == "C-NAMESPACE"
+    s.close()
+
+
+def test_retire_provenance_warns_but_admits():
+    """Warning severity: flagged, NEVER altered or rejected — MERGE stays a writer."""
+    s, g = _g()
+    g.merge(GraphDelta(adds=[SkillNode(skill="a")]))
+    rep = g.merge(GraphDelta(retires=["a"]))                        # no provenance
+    assert rep.retired == ["a"]                                     # admitted unchanged
+    assert any(cid == "C-RETIRE-PROVENANCE" and sev == "warning"
+               for _t, cid, sev in rep.flags)
+    clean = g.merge(GraphDelta(adds=[SkillNode(skill="b")]))
+    assert not any(cid == "C-RETIRE-PROVENANCE" for _t, cid, _s in clean.flags)
+    s.close()
+
+
+def test_live_suiteref_warns_but_admits():
+    """The honestly-narrowed second liveness clause: live+null suite_ref flags as a
+    warning (TA's provisioning does not populate suite_ref at the store layer yet)."""
+    s, g = _g()
+    rep = g.merge(GraphDelta(adds=[SkillNode(skill="a")]))          # live, suite_ref=None
+    assert rep.added == ["a"]
+    assert any(cid == "C-LIVE-SUITEREF" and sev == "warning" for _t, cid, sev in rep.flags)
+    s.close()
+
+
+def test_healthy_delta_no_flags_no_rejections():
+    s, g = _g()
+    rep = g.merge(GraphDelta(
+        adds=[SkillNode(skill="a", suite_ref="s1"), SkillNode(skill="b", suite_ref="s2")],
+        edges=[Edge(src="a", dst="b", confidence=0.8)],
+        provenance=["ev1"]))
+    assert rep.rejected == [] and rep.flags == []
+    s.close()
+
+
+def test_absorption_drops_internal_self_loop():
+    """The latent bug C-ACYCLIC surfaced: absorbing b into a redirected a→b into a
+    self-loop a→a (a skill as its own prerequisite) that lived in the graph unnoticed.
+    Contraction semantics now drop internal edges on unification."""
+    s, g = _g()
+    g.merge(GraphDelta(adds=[SkillNode(skill="a"), SkillNode(skill="b")],
+                       edges=[Edge(src="a", dst="b")]))
+    rep = g.merge(GraphDelta(merges=[("a", "b")]))
+    assert rep.merged == [("a", "b")]
+    assert all(e.src != e.dst for e in g.prereqs("a"))
+    s.close()
