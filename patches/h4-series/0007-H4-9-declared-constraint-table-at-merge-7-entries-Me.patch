+++ b/mdlp/mdlp/stores/constraints.py
@@ -0,0 +1,216 @@
+"""constraints.py (H4-9, DL §6.3) — the declared structural constraint table at merge().
+
+Generalizes the write path's hard-coded checks into DATA — an enumerable, versioned
+table the write path evaluates — so the constraint inventory stops being scattered code
+discovered one review round at a time (the reactive-constraint pattern, MDLP L-018).
+
+Semantics carried verbatim from DL §6.3:
+  * reject-and-report, never infer: no constraint outcome resolves an inconsistency by
+    coercing, merging, or silently fixing — an entry is applied unchanged or rejected;
+  * severities — `violation` rejects the entry (per-entry, siblings still apply);
+    `warning`/`info` admit the entry UNCHANGED and only flag (MERGE stays a projection
+    writer, never a gate: a warning that altered status would be MERGE assigning
+    liveness, which §6.2 forbids);
+  * every hit of every severity lands in `MergeReport.flags` — the caller's synchronous
+    channel; the truth-event trail is the orchestrator's job, not the store's;
+  * the predicate vocabulary is a FIXED set of factory-built checkers (no user code, no
+    eval — the §17.1 decidability reasoning): cardinality, enum/value-range, closed
+    shape, property-pair, edge-set acyclicity, namespace.
+
+TA-honest notes: the acyclicity entry is NEW protection at this layer — TA enforced
+acyclicity only in the in-process PathwayGraph (graph.py), never at the store write
+path, so a rebuild or direct delta could previously introduce a cycle the algorithm
+layer would then walk forever. The liveness entry MIGRATES the existing hard-coded
+check rejection-set-identically (same reason constant, same behavior).
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Callable, Optional
+
+VIOLATION = "violation"
+WARNING = "warning"
+INFO = "info"
+
+
+@dataclass
+class ConstraintEntry:
+    constraint_id: str
+    target: str                                  # "node" | "edge" | "delta"
+    check: Callable                              # factory-built; returns None (ok) or a reason str
+    severity: str = VIOLATION
+    anchor: str = ""                             # the approved-text reference grounding it
+
+
+@dataclass
+class ConstraintTable:
+    version: str
+    entries: list[ConstraintEntry] = field(default_factory=list)
+
+
+# --- the fixed predicate factories (the six families; no user code ever executes) ------
+
+def enum_member(attr: str, allowed: tuple) -> Callable:
+    def _check(obj, ctx) -> Optional[str]:
+        v = getattr(obj, attr, None)
+        return None if v in allowed else f"{attr}={v!r} not in {allowed}"
+    return _check
+
+
+def value_range(attr: str, lo: float, hi: float) -> Callable:
+    def _check(obj, ctx) -> Optional[str]:
+        v = getattr(obj, attr, None)
+        return None if (v is not None and lo <= v <= hi) else f"{attr}={v!r} outside [{lo},{hi}]"
+    return _check
+
+
+def property_pair(if_attr: str, equals, then_attr: str) -> Callable:
+    """if obj.if_attr == equals then obj.then_attr must be non-null."""
+    def _check(obj, ctx) -> Optional[str]:
+        if getattr(obj, if_attr, None) == equals and getattr(obj, then_attr, None) is None:
+            return f"{if_attr}={equals!r} requires non-null {then_attr}"
+        return None
+    return _check
+
+
+def namespace_reserved(attr: str, reserved: tuple) -> Callable:
+    def _check(obj, ctx) -> Optional[str]:
+        v = getattr(obj, attr, "") or ""
+        return f"{attr}={v!r} claims a reserved namespace" if v in reserved else None
+    return _check
+
+
+def retires_need_provenance() -> Callable:
+    def _check(delta, ctx) -> Optional[str]:
+        if delta.retires and not getattr(delta, "provenance", None):
+            return f"{len(delta.retires)} retire(s) with empty delta.provenance"
+        return None
+    return _check
+
+
+def acyclic_after_apply(kinds: tuple = ("prereq", "part_of")) -> Callable:
+    """Delta-level: the graph must stay acyclic over the kind-union AFTER applying the
+    delta's edges. `ctx['edges_after']` is supplied by the write path (the shadow state,
+    so the check sees exactly what would be committed)."""
+    def _check(delta, ctx) -> Optional[str]:
+        adj: dict = {}
+        for (src, dst, kind) in ctx.get("edges_after", ()):  # (src, dst, kind) triples
+            if kind in kinds:
+                adj.setdefault(src, []).append(dst)
+        WHITE, GREY, BLACK = 0, 1, 2
+        color = {n: WHITE for n in adj}
+        def dfs(n) -> bool:                       # True = cycle found
+            color[n] = GREY
+            for m in adj.get(n, ()):  # noqa: B023
+                c = color.get(m, WHITE)
+                if c == GREY:
+                    return True
+                if c == WHITE and dfs(m):
+                    return True
+            color[n] = BLACK
+            return False
+        for n in list(adj):
+            if color[n] == WHITE and dfs(n):
+                return f"cycle over {kinds} reachable from {n!r}"
+        return None
+    return _check
+
+
+def default_constraint_table(*, fanin_cap: Optional[int] = None,
+                             unprovisioned_reason: str = "unprovisioned node") -> ConstraintTable:
+    """The initial registered set — every entry anchored to approved text (DL §6.3: an
+    unanchored violation-grade entry does not ship). `fanin_cap=None` disables C-FANIN-CAP
+    (its §5.1 dial is unregistered in §12 — the honest conditional, not an invented cap)."""
+    entries = [
+        ConstraintEntry("C-LIVENESS-SHAPE", "node",
+                        _liveness_shape(unprovisioned_reason),
+                        VIOLATION, "§6.2 EXTRACT rule + RC-3 (migrated hard-coded check)"),
+        # live ⇒ non-null suite_ref is DL §6.3's full clause, but TA's provisioning does
+        # not yet populate suite_ref at the store layer (eval suites live in-process at
+        # the algorithm layer) — enforcing it as a violation would reject every existing
+        # live node. Shipped as a WARNING until provisioning writes suite_ref: honest
+        # narrowing, flagged not faked (the H4 discipline).
+        ConstraintEntry("C-LIVE-SUITEREF", "node",
+                        property_pair("status", "live", "suite_ref"),
+                        WARNING, "DL §6.3 C-LIVENESS-SHAPE second clause (deferred to violation when provisioning populates suite_ref)"),
+        ConstraintEntry("C-EDGE-TYPE", "edge",
+                        enum_member("kind", ("prereq", "part_of", "transition")),
+                        VIOLATION, "DL §5 edge schemas / B2 Amendment A"),
+        ConstraintEntry("C-CONF-RANGE", "edge",
+                        value_range("confidence", 0.0, 1.0),
+                        VIOLATION, "§5.2 / B2-AmendA (confidence is a belief)"),
+        ConstraintEntry("C-ACYCLIC", "delta",
+                        acyclic_after_apply(),
+                        VIOLATION, "B2 Amendment A (union acyclicity — NEW at this layer in TA)"),
+        ConstraintEntry("C-NAMESPACE", "node",
+                        namespace_reserved("skill", ("maintenance",)),
+                        VIOLATION, "ALGORITHM §20.2 (reserved namespace, defense in depth)"),
+        ConstraintEntry("C-RETIRE-PROVENANCE", "delta",
+                        retires_need_provenance(),
+                        WARNING, "§6.2 GraphDelta schema (delta-level provenance)"),
+    ]
+    if fanin_cap is not None:
+        entries.append(ConstraintEntry(
+            "C-FANIN-CAP", "delta", _fanin_cap(fanin_cap), VIOLATION,
+            "§5.1 add_soft_prereq_edges top-k cap (parameter-by-name, caller-bound)"))
+    return ConstraintTable(version="h4-9.1", entries=entries)
+
+
+def _liveness_shape(unprovisioned_reason: str) -> Callable:
+    def _check(node, ctx) -> Optional[str]:
+        statuses = ctx.get("provisioned_statuses", ("live", "pending_human"))
+        if node.status not in statuses:
+            return unprovisioned_reason              # rejection-set-identical migration
+        return None
+    return _check
+
+
+def _fanin_cap(cap: int) -> Callable:
+    def _check(delta, ctx) -> Optional[str]:
+        fanin: dict = {}
+        for (src, dst, kind) in ctx.get("edges_after", ()):
+            if kind == "prereq":
+                fanin[dst] = fanin.get(dst, 0) + 1
+        over = [n for n, k in fanin.items() if k > cap]
+        return f"prereq fan-in over cap {cap}: {over}" if over else None
+    return _check
+
+
+def evaluate(table: ConstraintTable, *, nodes=(), edges=(), delta=None,
+             ctx: Optional[dict] = None):
+    """One evaluation pass. Returns `(rejected_node_ids, rejected_edge_objs, flags)` where
+    flags = [(target_id, constraint_id, severity)]. Delta-level VIOLATIONS reject nothing
+    by themselves here — the write path decides attribution (per DL §6.3: attributable
+    entries reject per-entry; an unattributable delta violation rejects the whole delta)."""
+    ctx = ctx or {}
+    flags: list[tuple[str, str, str]] = []
+    bad_nodes: dict = {}
+    bad_edges: list = []
+    delta_violations: list[tuple[str, str]] = []
+    for entry in table.entries:
+        if entry.target == "node":
+            for n in nodes:
+                reason = entry.check(n, ctx)
+                if reason is not None:
+                    flags.append((n.skill, entry.constraint_id, entry.severity))
+                    if entry.severity == VIOLATION:
+                        # DL §6.3: constraint_id IS the reason string — except the migrated
+                        # liveness check, whose pre-table reason constant is preserved for
+                        # rejection-set-identity with existing callers/tests.
+                        bad_nodes[n.skill] = (reason if entry.constraint_id == "C-LIVENESS-SHAPE"
+                                              else entry.constraint_id)
+        elif entry.target == "edge":
+            for e in edges:
+                reason = entry.check(e, ctx)
+                if reason is not None:
+                    eid = f"{e.src}->{e.dst}:{e.kind}"
+                    flags.append((eid, entry.constraint_id, entry.severity))
+                    if entry.severity == VIOLATION:
+                        bad_edges.append((e, entry.constraint_id))
+        elif entry.target == "delta" and delta is not None:
+            reason = entry.check(delta, ctx)
+            if reason is not None:
+                flags.append(("delta", entry.constraint_id, entry.severity))
+                if entry.severity == VIOLATION:
+                    delta_violations.append((entry.constraint_id, reason))
+    return bad_nodes, bad_edges, delta_violations, flags
