diff --git a/mdlp/mdlp/stores/epoch.py b/mdlp/mdlp/stores/epoch.py
new file mode 100644
index 0000000..868447c
--- /dev/null
+++ b/mdlp/mdlp/stores/epoch.py
@@ -0,0 +1,54 @@
+"""epoch.py (H4-11, ALGORITHM §10.1) — epoch discipline: validation does not cross
+checkpoint generations.
+
+The rule, TA-scoped (the §17.6 scaffold machinery is M3-horizon; what exists today is
+the lineage chain every record already references): generation comparison is lineage
+ANCESTRY on recorded checkpoint_ids — never wall-clock, never version-string order —
+and a judgment from a generation OFF the current head's ancestor chain (a reverted
+span) is not merely stale, it is off-path: mandatory invalidate-or-absent, never
+served (§10.1's reverted-span rule; the §17.6 CAPTURE ancestry-not-existence
+precedent applied to judgments).
+
+Three legal moves for a cross-generation judgment: INVALIDATE (recompute from
+in-generation evidence), DISCOUNT (treat as absent, never as confirmation), or —
+reserved for the §17.3 fallback case alone, not implemented pre-M3 — serve-marked.
+Trusting is the fourth move, and it is illegal.
+"""
+from __future__ import annotations
+
+TRUSTED = "trusted"                # same generation — usable as-is
+INVALIDATE = "invalidate"          # ancestor generation — recompute or discount
+OFF_PATH = "off_path"              # reverted span — mandatory invalidate-or-absent
+UNKNOWN_GENERATION = "unknown"     # not in lineage at all — treat as OFF_PATH
+
+
+def _parents(truth) -> dict:
+    return dict(truth._db.execute(
+        "SELECT checkpoint_id, parent FROM lineage").fetchall())
+
+
+def is_ancestor(truth, old: str, head: str, *, max_depth: int = 10_000) -> bool:
+    """True iff `old` is `head` or an ancestor of `head` along the lineage parent chain.
+    Ancestry, not existence — a checkpoint whose commit was later reverted exists in
+    lineage but is NOT on the current chain, and must not pass (§17.6's load-bearing
+    choice, §10.1's rule)."""
+    parents = _parents(truth)
+    node, depth = head, 0
+    while node is not None and depth <= max_depth:
+        if node == old:
+            return True
+        node = parents.get(node)
+        depth += 1
+    return False
+
+
+def judgment_status(truth, judgment_gen: str, head_gen: str) -> str:
+    """Classify a validation-grade judgment's generation against the live head."""
+    if judgment_gen == head_gen:
+        return TRUSTED
+    parents = _parents(truth)
+    if judgment_gen not in parents and judgment_gen not in set(parents.values()):
+        return UNKNOWN_GENERATION
+    if is_ancestor(truth, judgment_gen, head_gen):
+        return INVALIDATE
+    return OFF_PATH
diff --git a/mdlp/tests/test_epoch.py b/mdlp/tests/test_epoch.py
new file mode 100644
index 0000000..9f30257
--- /dev/null
+++ b/mdlp/tests/test_epoch.py
@@ -0,0 +1,39 @@
+"""H4-11 (§10.1): epoch discipline helpers — ancestry not existence, wall-clock never."""
+from mdlp.stores import embedded
+from mdlp.stores.epoch import (INVALIDATE, OFF_PATH, TRUSTED, UNKNOWN_GENERATION,
+                               is_ancestor, judgment_status)
+
+
+def _chain():
+    s = embedded()
+    db = s.truth._db
+    # main chain c1 <- c2 <- c3 (head), plus a REVERTED branch c2 <- r1
+    db.executescript("""
+        INSERT INTO lineage(checkpoint_id, parent) VALUES
+        ('c1', NULL), ('c2', 'c1'), ('c3', 'c2'), ('r1', 'c2');
+    """)
+    db.commit()
+    return s
+
+
+def test_ancestor_on_chain_invalidates_never_trusts():
+    s = _chain()
+    assert is_ancestor(s.truth, "c1", "c3")
+    assert judgment_status(s.truth, "c1", "c3") == INVALIDATE
+    assert judgment_status(s.truth, "c3", "c3") == TRUSTED
+    s.close()
+
+
+def test_reverted_span_is_off_path():
+    """r1 EXISTS in lineage but is not an ancestor of head c3 — existence is not
+    ancestry (the §17.6 CAPTURE choice): mandatory invalidate-or-absent."""
+    s = _chain()
+    assert not is_ancestor(s.truth, "r1", "c3")
+    assert judgment_status(s.truth, "r1", "c3") == OFF_PATH
+    s.close()
+
+
+def test_unknown_generation_treated_as_off_path_class():
+    s = _chain()
+    assert judgment_status(s.truth, "ghost", "c3") == UNKNOWN_GENERATION
+    s.close()
